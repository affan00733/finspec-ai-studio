# FinSpec AI Studio — environment template
# Copy to .env (backend) or frontend/.env.local as needed.
# NEVER commit real API keys.

# --- Django (backend/.env) ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Paid LLM providers — only used when explicitly selected. Mock/offline is the default.
# No silent fallback from a failed paid provider to mock output.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_DEPLOYMENT=

# Optional Celery (runs execute inline when false)
FINSPEC_CELERY_ENABLED=false
CELERY_BROKER_URL=redis://localhost:6379/0

# --- Frontend (frontend/.env.local) ---
# Leave unset for the browser-only Netlify/offline demo.
# Set to connect the UI to a local Django API:
# VITE_API_URL=http://localhost:8000/api
