# Copy to .env. Everything is optional: with no variables set the backend runs fully offline (mock).
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Paid providers - only used when an agent/request explicitly selects them. No silent fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_DEPLOYMENT=

# Optional Celery (runs execute inline when false)
FINSPEC_CELERY_ENABLED=false
CELERY_BROKER_URL=redis://localhost:6379/0
